# Public port on the loopback interface. The container listens on 4318.
APP_PORT=4318

# Host gcloud configuration directory.
# macOS/Linux: /Users/you/.config/gcloud or /home/you/.config/gcloud
# Windows: C:/Users/you/AppData/Roaming/gcloud
GCLOUD_CONFIG_DIR=/absolute/path/to/gcloud

# Change only when the ADC file has a non-standard name inside the mounted directory.
CONTAINER_ADC_PATH=/home/node/.config/gcloud/application_default_credentials.json

# Required Google Cloud configuration. Never commit real values in .env.
BQ_AGENT_BILLING_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_QUOTA_PROJECT=your-google-cloud-project
BQ_AGENT_LOCATION=global
BQ_AGENT_RESOURCE=projects/your-google-cloud-project/locations/global/dataAgents/your-data-agent-id
BQ_AGENT_LABEL=My BigQuery Data Agent
VERTEX_AI_PROJECT=your-google-cloud-project
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_AI_JUDGE_MODEL=gemini-2.5-flash-lite
